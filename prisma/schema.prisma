// U2E Apartments — Prisma schema (Prisma v7).
// New `prisma-client` generator (ESM/TS) + query compiler; runtime queries go
// through a driver adapter (see src/lib/prisma.ts). The connection URL lives in
// prisma.config.ts, not here.
//
// multiSchema: content (units/rooms) is owned by the CRM in the `crm` schema.
// This guest site READS `crm.Room` for accommodation listings. `public` holds
// this app's own tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["crm", "public"]
}

// ---------------------------------------------------------------------------
// crm schema — owned by the CRM; read-only from this app
// ---------------------------------------------------------------------------

enum FaqCategory {
  ACCOMMODATION
  GENERAL
  DINING
  EXPERIENCE
  SUPPORT
  RESERVATIONS

  @@schema("crm")
}

/// Guest-facing FAQs, grouped by category. Mirrors `crm.Faq`.
model Faq {
  id        String      @id @default(cuid())
  category  FaqCategory @default(GENERAL)
  question  String
  answer    String
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category])
  @@index([active])
  @@schema("crm")
}

// ── Site configuration (singletons + bank list), authored in the CRM ──────

/// Bank accounts for offline (bank-transfer) payments. Mirrors `crm.BankAccount`.
model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([archived])
  @@schema("crm")
}

/// Social media links (singleton config). Mirrors `crm.SocialMedia`.
model SocialMedia {
  id        String   @id @default(cuid())
  facebook  String   @default("")
  instagram String   @default("")
  x         String   @default("")
  tiktok    String   @default("")
  updatedAt DateTime @updatedAt

  @@schema("crm")
}

/// Contact details + map embed (singleton config). Mirrors `crm.ContactInfo`.
model ContactInfo {
  id        String   @id @default(cuid())
  address   String   @default("")
  email     String   @default("")
  mobile    String   @default("")
  mapUrl    String   @default("")
  updatedAt DateTime @updatedAt

  @@schema("crm")
}

/// Guest experiences authored in the CRM. Mirrors `crm.Experience`.
/// `spotlight` marks experiences featured in the home-page experiences section.
model Experience {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  spotlight   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([spotlight])
  @@schema("crm")
}

/// Gallery images authored in the CRM. Mirrors `crm.GalleryImage`.
/// `spotlight` marks images featured in the home-page marquee. (Read model —
/// the `categoryId` FK is kept scalar; we don't need the category relation here.)
model GalleryImage {
  id         String   @id @default(cuid())
  categoryId String
  image      String
  alt        String   @default("")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  spotlight  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
  @@index([active])
  @@index([spotlight])
  @@schema("crm")
}

/// A bookable unit/room type, authored in the CRM. Mirrors `crm.Room`.
model Room {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  bedrooms      Int      @default(1)
  bathrooms     Int      @default(1)
  units         Int      @default(1) // how many physical units of this type exist
  sleeps        Int      @default(2)
  size          String
  priceFrom     Int      @default(0) // NGN, per stay
  inSuiteDiningTitle   String @default("In-Suite Dining")
  inSuiteDining        String @default("") // editorial highlight
  kitchenFeaturesTitle String @default("Rooftop Aperitif")
  kitchenFeatures      String @default("") // editorial highlight
  featuredImage String?
  images        String[]
  services      String[]
  extraBed      Boolean  @default(false)
  extraBedPrice Int      @default(0)
  extraBedMax   Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@schema("crm")
}

enum SocialSource {
  INSTAGRAM
  TIKTOK

  @@schema("crm")
}

/// Social feed posts shown in the home-page marquee. Mirrors `crm.SocialPost`.
/// The per-platform profile link lives on the `SocialMedia` singleton, so a post
/// only carries an optional deep link to itself.
model SocialPost {
  id        String       @id @default(cuid())
  source    SocialSource @default(INSTAGRAM)
  image     String
  caption   String       @default("")
  postUrl   String?
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([source])
  @@index([active])
  @@schema("crm")
}

/// Menu categories authored in the CRM. Mirrors `crm.MenuCategory` — read to
/// group and order the full menu listing.
model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  items       MenuList[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@schema("crm")
}

/// Dining menu items authored in the CRM. Mirrors `crm.MenuList`.
model MenuList {
  id          String       @id @default(cuid())
  name        String
  description String
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  price       Int          @default(0) // NGN
  available   Boolean      @default(true)
  archived    Boolean      @default(false)
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([archived])
  @@index([categoryId])
  @@schema("crm")
}

/// Event categories authored in the CRM. Mirrors `crm.EventCategory` — we read
/// it only to label each event card.
model EventCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("crm")
}

/// Dated happenings hosted at U2E, authored in the CRM. Mirrors `crm.Event`.
model Event {
  id          String        @id @default(cuid())
  categoryId  String
  category    EventCategory @relation(fields: [categoryId], references: [id])
  slug        String        @unique
  title       String
  description String
  eventDate   DateTime
  image       String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([active])
  @@schema("crm")
}

// ---------------------------------------------------------------------------
// public schema — owned by this app
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// Inventory bucket a reservation occupies. Reservations reference rooms via
/// this enum rather than a room id/slug.
enum RoomType {
  TWO_BED
  THREE_BED

  @@schema("public")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  NOT_FOUND
  FAILED

  @@map("ReservationStatus")
  @@schema("public")
}

/// Reservations (table owned by the event site's `public` schema). This app
/// both reads them (availability, reviews) and writes them (the booking flow).
/// `roomType` stays the primary/first room for backward-compat with the event
/// app + CRM; the full room set lives in `ReservationRoom` lines.
model Booking {
  id                String        @id @default(cuid())
  reservationNumber String        @unique // human-shareable ref, quoted on reviews
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  checkIn           String
  checkOut          String
  bookingType       String        @default("single") // "single" | "multiple"
  guests            Int           @default(1)
  roomType          RoomType
  extraBed          Boolean       @default(false)
  extraBeds         Int           @default(1)
  name              String        @default("")
  email             String        @default("")
  phone             String?
  dialCode          String?
  company           String?
  status            BookingStatus @default(PENDING)
  isReviewAvailable Boolean       @default(false)
  ipAddress         String?
  agreedToTerms     Boolean       @default(false)
  amount            Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  rooms             ReservationRoom[]
  // Payment columns (paymentMethod / receiptUrl / receiptFileName /
  // paystackReference) remain physically on this event-owned table for the
  // event app + legacy rows, but this app no longer writes them — payment data
  // lives in `Payment`, linked by reservationNumber.

  @@map("Reservation")
  @@schema("public")
}

/// One room line within a reservation — lets a single booking hold multiple
/// rooms (e.g. a 2BR + a 3BR), each with a quantity. Additive to the shared
/// schema; legacy reservations simply have no lines.
model ReservationRoom {
  id                String   @id @default(cuid())
  reservationNumber String
  roomSlug          String
  roomType          RoomType
  qty               Int      @default(1) // how many of this room
  guests            Int      @default(1) // party in this room
  extraBed          Boolean  @default(false)
  extraBeds         Int      @default(1)
  createdAt         DateTime @default(now())
  reservation       Booking  @relation(fields: [reservationNumber], references: [reservationNumber], onDelete: Cascade)

  @@index([reservationNumber])
  @@index([roomType])
  @@schema("public")
}

/// Payment records (table owned by the event site's `public` schema). Written
/// here when the guest completes the payment step; the CRM Payments view lists
/// these. `method` is "online" | "receipt"; `status` is "success" | "pending" |
/// "not_found" | "failed".
/// Guests, deduplicated by email. A reservation and its payments both reference
/// the customer, so contact details live in one place.
model Customer {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  phone        String?
  dialCode     String?
  company      String?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Booking[]
  payments     Payment[]

  @@map("Customer")
  @@schema("public")
}

model Payment {
  id                String    @id @default(cuid())
  reservationNumber String
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  email             String
  amount            Int
  method            String
  status            String
  paystackReference String?
  receiptUrl        String? // bank-transfer receipt (payment artefact, not reservation)
  receiptFileName   String?
  ip                String?
  createdAt         DateTime  @default(now())

  @@index([customerId])
  @@map("Payment")
  @@schema("public")
}

/// Guest reviews (authored/moderated in the CRM). Mirrors `crm.Review` — read
/// here to publish approved reviews on the room page and written here on submit.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("crm")
}

model Review {
  id                String       @id @default(cuid())
  reservationNumber String
  roomSlug          String
  roomTitle         String       @default("")
  guestName         String
  rating            Int          @default(5)
  body              String
  status            ReviewStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([roomSlug])
  @@schema("crm")
}
